{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ufLabelPrinter",
  "version": "0.1.0",
  "identifier": "com.unfuckedapps.uflabelprinter",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ufLabelPrinter",
        "width": 1180,
        "height": 820,
        "minWidth": 900,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "fileAssociations": [
      {
        "ext": [
          "pdf"
        ],
        "name": "PDF document",
        "mimeType": "application/pdf",
        "role": "Viewer",
        "rank": "Alternate"
      }
    ],
    "macOS": {
      "infoPlist": "Info.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "unfuckedapps",
    "homepage": "https://github.com/unfuckedapps/ufLabelPrinter",
    "shortDescription": "Print shipping labels to thermal label printers",
    "longDescription": "Prints PDF and image labels to Phomemo, Vevor and other TSPL thermal printers over USB and Bluetooth LE, without vendor software.",
    "linux": {
      "deb": {
        "depends": [
          "bluez"
        ]
      },
      "rpm": {
        "depends": [
          "bluez"
        ]
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI3OTIyNzFDMkYwRjM1RjQKUldUME5ROHZIQ2VTdDR1TEpxYUlzalhINXFaQWhnR0pnWVBIQUxlNkpML2ZWWnJSK1RieW1ROEUK",
      "endpoints": [
        "https://github.com/unfuckedapps/ufLabelPrinter/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
